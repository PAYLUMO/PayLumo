# API PayLumo — copier vers .env pour le dev local,
# ou définir ces variables dans le dashboard Vercel pour la prod.

# --- Lecture du bulletin (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
PAYLUMO_MODEL=claude-opus-5

# --- Paiement (Stripe) ---
# Clé secrète : sk_test_... en dev, sk_live_... en prod.
STRIPE_SECRET_KEY=sk_test_...
# Prix d'une analyse, en centimes d'euro.
PAYLUMO_PRICE_CENTS=99

# --- Commun ---
# Origines autorisées (CSV). En prod : l'URL de l'app.
ALLOWED_ORIGINS=http://localhost:5173
MAX_PDF_MB=8
RATE_LIMIT_PER_HOUR=30
PORT=8787
